#!/usr/bin/env bash
# SecAuto launcher - built by Naman Kumar Sonker (@nksdev)
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

PYTHON="${SECAUTO_PYTHON:-}"
if [ -z "$PYTHON" ]; then
  for candidate in python3.14 python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      PYTHON="$(command -v "$candidate")"
      break
    fi
  done
fi

if [ -z "$PYTHON" ]; then
  echo "secauto: no Python 3 interpreter found on PATH" >&2
  exit 127
fi

cd "$ROOT"
exec "$PYTHON" -m secauto "$@"
